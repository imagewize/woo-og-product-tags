{
    "name": "imagewize/woo-og-product-tags",
    "type": "wordpress-plugin",
    "description": "Prints the Open Graph product tags (product:price:amount, product:price:currency, product:availability) on single WooCommerce product pages.",
    "keywords": ["wordpress", "plugin", "woocommerce", "open-graph", "opengraph", "seo", "merchant-center"],
    "homepage": "https://github.com/imagewize/woo-og-product-tags",
    "license": "MIT",
    "authors": [
        {
            "name": "Imagewize",
            "homepage": "https://imagewize.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "composer/installers": "^2.0"
    },
    "require-dev": {
        "php-stubs/woocommerce-stubs": "^10.0",
        "php-stubs/wordpress-stubs": "^6.5",
        "laravel/pint": "^1.29"
    },
    "autoload": {
        "psr-4": {
            "Imagewize\\WooOgProductTags\\": "./"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
